rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each player can only change their own profile, rating and scores.
    match /players/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /scores/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    // Usernames, so two people can't take the same one.
    match /names/{name} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Open challenges: you post and remove your own, others can claim it.
    match /seeks/{uid} {
      allow read: if true;
      allow create, delete: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null;
    }
    // Games: only the two players can change a game.
    match /games/{gid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.players;
      allow update, delete: if request.auth != null && request.auth.uid in resource.data.players;
    }
  }
}
